{
  "manifest_version": 3,
  "name": "DevWait AI",
  "version": "1.0.0",
  "description": "AI-powered developer assistant.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "contextMenus"

  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ]
    }
  ]
}