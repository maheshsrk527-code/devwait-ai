{
  "manifest_version": 3,

  "name": "DevWait AI",

  "version": "1.0.0",

  "description": "AI-powered developer assistant for explaining, fixing and debugging code.",

  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "contextMenus"
  ],
"host_permissions": [
  "https://devwait-ai.onrender.com/*",
  "https://dlgcistpcixrffeigruy.supabase.co/*"
],
  
  

  "action": {
    "default_popup": "popup.html"
  },

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ]
    }
  ]
}